# Environment variables for tenantos-registrar (read from application.yaml).
# Copy to .env and fill in. Section 1 = no default in application.yaml, the app will NOT start without it.
# Section 2 = optional, the value shown is the built-in default.
# Note: with the default `local` profile, application-local.yaml overrides many of these with
# hardcoded values; the variables below are what a non-local profile/deployment must supply.

# ======================================================================
# 1. REQUIRED
# ======================================================================

# --- Registrar database ---
DB_URL=jdbc:postgresql://localhost:54321/tenantos_registrar
POSTGRES_USER=tenantos-master
POSTGRES_PASSWORD=change-me
# Only used by compose.yml to create the registrar DB container
DB_NAME=tenantos_registrar

# --- Tenant data server (separate Postgres from the registrar's) ---
# Admin role needs only CREATEDB + CREATEROLE.
TENANT_DB_ADMIN_URL=jdbc:postgresql://localhost:54323/postgres
TENANT_DB_ADMIN_USER=tenantos-tenant-admin
TENANT_DB_ADMIN_PASSWORD=change-me
# Host/port published to tenants (what their workloads dial)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=54323
# Secret naming for published tenant DB credentials
TENANT_DB_SECRET_PREFIX=tenantos/tenant
TENANT_DB_K8S_SECRET_NAME=tenant-db-credentials

# --- SMTP (local: mailpit on 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Security ---
# Signing key for tenant access tokens. Blank = ephemeral per-process key (tokens die on restart and
# other replicas reject them), so set it for anything beyond a single local instance.
# e.g. `openssl rand -base64 48`
TENANTS_AUTH_JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Server ---
PORT=8080

# ======================================================================
# 2. OPTIONAL (defaults shown)
# ======================================================================

# --- Spring ---
# SPRING_PROFILES_ACTIVE=local

# --- Registrar DB pool ---
# DB_POOL_MIN_IDLE=2
# DB_POOL_MAX_SIZE=10
# DB_POOL_IDLE_TIMEOUT_MS=300000
# DB_POOL_MAX_LIFETIME_MS=1800000
# DB_POOL_CONNECTION_TIMEOUT_MS=30000
# DB_POOL_VALIDATION_TIMEOUT_MS=5000

# --- SMTP ---
# SMTP_AUTH=false
# SMTP_STARTTLS=false

# --- Onboarding ---
# ONBOARDING_TOKEN_COOKIE_NAME=onboarding_token
# ONBOARDING_TOKEN_TTL_SECONDS=3600
# ONBOARDING_OTP_TTL_SECONDS=600
# ONBOARDING_OTP_MAX_ATTEMPTS=5
# ONBOARDING_OTP_GENERATION_MAX_COUNT=3
# ONBOARDING_OTP_GENERATION_WINDOW_SECONDS=3600
# ONBOARDING_OTP_FROM_ADDRESS=no-reply@tenantos.local
# ONBOARDING_FE_APP_URL=http://localhost:3000

# --- Workspace provisioning worker ---
# WORKSPACE_PROVISIONING_ENABLED=true
# WORKSPACE_PROVISIONING_POLL_INTERVAL_MS=5000
# WORKSPACE_PROVISIONING_INITIAL_DELAY_MS=15000
# WORKSPACE_PROVISIONING_BATCH_SIZE=10
# WORKSPACE_PROVISIONING_MAX_ATTEMPTS=5
# WORKSPACE_PROVISIONING_BACKOFF_SECONDS=30
# WORKSPACE_PROVISIONING_MAX_BACKOFF_SECONDS=900
# WORKSPACE_PROVISIONING_LEASE_SECONDS=600

# --- Tenant defaults ---
# TENANT_DEFAULT_PLAN=FREE_TRIAL
# TENANT_TRIAL_DAYS=14
# TENANT_TRIAL_LIMITS={"seats":5,"apiCallsPerMonth":100000,"storageGb":5}

# --- Tenant database provisioning ---
# TENANT_DATABASE_ENABLED=true
# TENANT_DB_CONNECTION_LIMIT=20
# false = skip writing the Kubernetes secret
# TENANT_DB_K8S_SECRET_ENABLED=false
# Only if you need a kubeconfig other than ~/.kube/config
# KUBECONFIG=/home/you/.kube/config

# --- Infisical (PROVISION_INFISICAL_SECRETS step) ---
# false = skip the step. Fill the rest in when you turn it on.
# INFISICAL_ENABLED=false
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# Comma-separated; every one gets the same folders and secrets
# INFISICAL_ENVIRONMENTS=dev,staging,prod
# TENANT_* DB credentials are written to /<slug>/backend automatically; these extra keys are
# seeded there as placeholders (comma-separated)
# INFISICAL_BACKEND_SECRET_KEYS=JWT_SECRET
# INFISICAL_SECRET_PLACEHOLDER=CHANGE_ME

# --- Tenant app deployment (DISPATCH_TENANT_DEPLOY / AWAIT_TENANT_DEPLOY steps) ---
# false = both steps are skipped. Fill the rest in when you turn it on.
# TENANT_DEPLOY_ENABLED=false
# TENANT_DEPLOY_ENV=prod
# TENANT_DEPLOY_BACKEND_IMAGE=registry.example.com/homelab/tenantos-backend:<tag>
# TENANT_DEPLOY_UI_IMAGE=registry.example.com/homelab/tenantos-ui:<tag>
# TENANT_DEPLOY_REDIS_URL=redis://redis.example.com:6379
# FORGEJO_API_URL=https://forgejo.example.com
# FORGEJO_DISPATCH_TOKEN=
# TENANT_DEPLOY_REPOSITORY=Homelab/tenantos-registrar
# TENANT_DEPLOY_AWAIT_TIMEOUT_SECONDS=240

# --- Tenant auth ---
# TENANT_ACCESS_TOKEN_TTL_SECONDS=900
# TENANT_REFRESH_TOKEN_TTL_SECONDS=2592000
# TENANT_SESSION_TTL_SECONDS=2592000
# TENANT_REFRESH_COOKIE_NAME=tenant_refresh_token

# --- JWT / CORS / rate limiting ---
# JWT_TTL_SECONDS=3600
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Authorization,Content-Type,apiKey
# CORS_MAX_AGE=3600
# CORS_ALLOW_CREDENTIALS=true
# RATE_LIMIT_ONBOARDING_ENABLED=true
# RATE_LIMIT_ONBOARDING_MAX_REQUESTS=60
# RATE_LIMIT_ONBOARDING_WINDOW_SECONDS=60

# --- Logging ---
# LOG_LEVEL_APP=TRACE
# LOG_LEVEL_SPRING=INFO
# LOG_LEVEL_FLYWAY=DEBUG

# Operator endpoints (DELETE /admin/tenants). Blank = disabled.
#ADMIN_API_TOKEN=
